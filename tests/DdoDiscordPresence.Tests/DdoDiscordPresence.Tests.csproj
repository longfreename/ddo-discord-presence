<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console test runner (run this project with dotnet run, Release configuration).
       Needs neither the game nor Discord: the pipe tests run their own in-process pipe server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>DdoDiscordPresence.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DdoDiscordPresence\DdoDiscordPresence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-4f7c-pmjv-c25w" />
  </ItemGroup>
</Project>
